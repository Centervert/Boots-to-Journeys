# Canonical site URL for metadata / Open Graph (include https, no trailing slash)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Supabase (scheduling + appointments). Service role is server-only — never expose to the client.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: Cloudflare Turnstile (recommended production). If TURNSTILE_SECRET_KEY is set, bookings must pass verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: after a successful DB booking, POST the same payload + appointmentId to this URL (Zapier, Make, etc.)
BOOKING_WEBHOOK_URL=
BOOKING_WEBHOOK_SECRET=
